{
  "name": "initial-d",
  "version": "1.0.0",
  "description": "Initial D style endless racing game built with Phaser 3.",
  "homepage": "https://github.com/lowcash/initial-d#readme",
  "main": "index.js",
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider webpack-dev-server --config webpack/webpack.dev.js",
    "build": "NODE_OPTIONS=--openssl-legacy-provider webpack --config webpack/webpack.prod.js",
    "bundle": "npm run build",
    "serve": "serve dist"
  },
  "keywords": [
    "Phaser",
    "Phaser 3",
    "Phaser3",
    "html5 game",
    "TypeScript",
    "webpack",
    "starter"
  ],
