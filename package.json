{
  "name": "initial-d",
  "version": "1.0.0",
  "description": "Initial D style endless racing game built with Phaser 3.",
  "homepage": "https://github.com/lowcash/initial-d#readme",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"index.html\" \"vite.config.ts\" \"vitest.config.ts\" \"eslint.config.js\" \"playwright.config.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve": "serve dist",
    "size": "node scripts/check-size.mjs"
  },
  "keywords": [
    "Phaser",
    "Phaser 3",
    "Phaser3",
    "html5 game",
    "TypeScript",
    "Vite"
  ],
  "author": {
    "name": "Lukáš Machala",
    "url": "https://github.com/lowcash"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lowcash/initial-d.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.19.1",
    "eslint": "^10.15.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "8.3.8",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^5.1.0"
  }
}
